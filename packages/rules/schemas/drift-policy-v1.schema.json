{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/drift-policy-v1",
  "$defs": {
    "drift-policy-v1": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "const": "drift-policy/v1"
        },
        "failOn": {
          "type": "string",
          "enum": [
            "breaking",
            "risky"
          ]
        },
        "riskyIsMajor": {
          "type": "boolean"
        },
        "escalate": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "path.added",
                  "path.removed",
                  "operation.added",
                  "operation.removed",
                  "operation.deprecated",
                  "path.param.renamed",
                  "param.added.required",
                  "param.added.optional",
                  "param.removed",
                  "param.made_required",
                  "param.made_optional",
                  "param.location_changed",
                  "param.deprecated",
                  "request.body.added.required",
                  "request.body.added.optional",
                  "request.body.removed",
                  "request.body.made_required",
                  "request.body.made_optional",
                  "media_type.added",
                  "media_type.removed",
                  "response.status.added",
                  "response.error_status.added",
                  "response.status.removed",
                  "schema.property.added.required",
                  "schema.property.added.optional",
                  "schema.property.removed",
                  "schema.property.made_required",
                  "schema.property.made_optional",
                  "schema.type.narrowed",
                  "schema.type.widened",
                  "schema.type.changed",
                  "schema.format.changed",
                  "schema.enum.value_added",
                  "schema.enum.value_removed",
                  "schema.bound.tightened",
                  "schema.bound.relaxed",
                  "schema.additional_properties.tightened",
                  "schema.additional_properties.relaxed",
                  "schema.variant.added",
                  "schema.variant.removed",
                  "schema.composition.changed",
                  "schema.discriminator.changed",
                  "schema.default.changed",
                  "schema.deprecated",
                  "security.requirement.added",
                  "security.requirement.removed",
                  "doc.changed"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "request",
                  "response"
                ]
              },
              "ruleId": {
                "type": "string",
                "pattern": "^DRIFT(?:-[A-Z0-9]+)+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "changeId": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "ruleId": {
                "type": "string",
                "pattern": "^DRIFT(?:-[A-Z0-9]+)+$"
              },
              "operation": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              },
              "expiresAt": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "reason",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false,
      "title": "DRIFT project policy (drift-policy/v1)"
    }
  }
}
