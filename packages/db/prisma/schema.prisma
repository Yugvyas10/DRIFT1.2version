// The DRIFT platform's data model (PLAN §6 M5). Owner: P3.
//
// Rules that hold for every model:
// - Every tenant-owned row carries `orgId`, and every query filters by it (see apps/web/src/server).
// - Ids are generated by the application (`<prefix>_<random base36>`), so they can be used in URLs and logs.
// - Secrets are never stored: passwords as bcrypt hashes, API keys and invitation tokens as SHA-256 hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum RunStatus {
  UPLOADING
  COMPLETE
  FAILED
}

enum RunTrigger {
  CI
  MANUAL
  APP
}

enum StageStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum Severity {
  BREAKING
  RISKY
  SAFE
}

// ── Identity ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id
  email        String   @unique // stored in lower case
  name         String?
  /// bcrypt; null for users who only sign in through GitHub.
  passwordHash String?
  /// Raised on password change and "sign out everywhere"; a session token with an older value is refused.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts    Account[]
  memberships Membership[]
}

/// An OAuth identity (GitHub) linked to a user. Sessions are signed JWTs (ADR-0007), so there is no Session table.
model Account {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ── Tenancy ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  memberships  Membership[]
  invitations  Invitation[]
  projects     Project[]
  apiKeys      ApiKey[]
  runs         Run[]
  artifacts    Artifact[]
  policies     Policy[]
  suppressions Suppression[]
  auditLogs    AuditLog[]
}

model Membership {
  id        String   @id
  orgId     String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id
  orgId       String
  email       String
  role        Role
  /// SHA-256 of the token mailed to the invitee; the token itself is shown once and never stored.
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Project {
  id        String   @id
  orgId     String
  slug      String
  name      String
  /// `owner/name` of the bound GitHub repository, if any.
  repo      String?
  /// Path of the OpenAPI contract in that repository.
  specPath  String?
  createdAt DateTime @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  runs         Run[]
  policies     Policy[]
  suppressions Suppression[]

  @@unique([orgId, slug])
}

model ApiKey {
  id          String    @id
  orgId       String
  /// Null: valid for every project of the organisation.
  projectId   String?
  name        String
  /// The first characters of the key (`drift_ab12cd34`), to recognise it in lists. Not a secret.
  prefix      String
  /// SHA-256 (hex) of the whole key. The key is shown once at creation.
  hash        String    @unique
  permissions String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ── Runs ──────────────────────────────────────────────────────────────────────

model Run {
  id             String     @id
  orgId          String
  projectId      String
  status         RunStatus
  trigger        RunTrigger
  /// Chosen by the client; the same key with the same request returns the same run.
  idempotencyKey String
  /// SHA-256 of the canonical request body, to tell a replay from a different request with the same key.
  requestHash    String
  commit         String
  branch         String?
  pullRequest    Int?
  baseSpecHash   String
  headSpecHash   String
  engineVersion  String
  rulesVersion   String
  rulesHash      String
  policyHash     String
  gatePassed     Boolean
  failOn         String
  breaking       Int
  risky          Int
  safe           Int
  suppressed     Int
  semver         String
  errorCategory  String?
  /// The run this one re-runs (M6).
  parentRunId    String?
  createdByKeyId String?
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Run?             @relation("Rerun", fields: [parentRunId], references: [id], onDelete: SetNull)
  reruns    Run[]            @relation("Rerun")
  stages    StageExecution[]
  artifacts Artifact[]
  changes   Change[]

  @@unique([orgId, idempotencyKey])
  @@index([projectId, createdAt])
}

model StageExecution {
  id               String      @id
  orgId            String
  runId            String
  stage            String
  attempt          Int         @default(1)
  status           StageStatus
  /// The stage's content-addressed key (ADR-0006).
  cacheKey         String
  cacheHit         Boolean
  startedAt        DateTime?
  finishedAt       DateTime?
  metrics          Json?
  outputArtifactId String?
  logArtifactId    String?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage, attempt])
}

model Artifact {
  id          String    @id
  orgId       String
  runId       String
  kind        String
  sha256      String
  size        Int
  contentType String
  /// Object-storage key: `orgs/<orgId>/sha256/<sha256>` (org-scoped and content-addressed, ADR-0006).
  storageKey  String
  /// Set when the server has seen the object and checked its SHA-256.
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run Run          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, kind])
  @@index([orgId, sha256])
}

model Change {
  id         String   @id
  orgId      String
  runId      String
  /// The engine's stable change id (drift-report/v1 `changes[].id`).
  changeId   String
  kind       String
  direction  String
  operation  String
  location   String
  severity   Severity
  ruleId     String
  message    String
  confidence Float?
  suppressed Boolean  @default(false)

  run      Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence Evidence?

  @@unique([runId, changeId])
  @@index([orgId])
}

/// The summary of a change's evidence. Redacted payloads stay in the report artifact (object storage).
model Evidence {
  id               String  @id
  orgId            String
  changeRowId      String  @unique
  status           String
  checkedRecorded  Int
  checkedSynthetic Int
  failedRecorded   Int
  failedSynthetic  Int
  unknown          Int
  /// The artifact holding the redacted payloads (the report JSON), once uploaded.
  artifactId       String?

  change Change @relation(fields: [changeRowId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ── Policy and history ────────────────────────────────────────────────────────

model Policy {
  id        String   @id
  orgId     String
  projectId String?
  name      String
  /// A drift-policy/v1 document.
  document  Json
  hash      String
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Suppression {
  id          String   @id
  orgId       String
  projectId   String
  /// The engine change id this suppression accepts.
  changeId    String
  reason      String
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId])
}

/// Append-only: the first migration adds a trigger that rejects UPDATE and DELETE on this table.
model AuditLog {
  id          String   @id
  orgId       String
  actorUserId String?
  actorKeyId  String?
  action      String
  targetType  String
  targetId    String
  metadata    Json
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

/// GitHub webhook deliveries, for idempotency (used by App mode, M8).
model WebhookDelivery {
  id          String    @id
  provider    String
  deliveryId  String
  event       String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, deliveryId])
}
