{
  "name": "@drift/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Evaluation harness: pinned real-world fixtures, fixture checks, and (from M3) the performance and mutation benchmarks.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "fixtures:fetch": "node src/fetch-fixtures.ts",
    "fixtures:check": "node src/check-fixtures.ts"
  },
  "dependencies": {
    "@drift/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
