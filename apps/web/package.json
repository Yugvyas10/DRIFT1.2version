{
  "name": "@drift/web",
  "version": "0.0.0",
  "private": true,
  "description": "DRIFT web app: dashboard, sign-in and the REST API (apps/web/openapi/drift-api.yaml).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "demo:seed": "node scripts/demo-seed.ts"
  },
  "dependencies": {
    "@drift/core": "workspace:*",
    "@drift/db": "workspace:*",
    "@drift/platform": "workspace:*",
    "@drift/report-schema": "workspace:*",
    "bcryptjs": "3.0.3",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
