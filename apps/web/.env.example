# Copy to apps/web/.env.local for local development. Values match infra/docker-compose.yml.
# Public base URL of this deployment; used for canonical URLs and sign-in callbacks.
APP_URL=http://localhost:3000

# Postgres (docker compose). Apply the schema with: pnpm --filter @drift/db run migrate:deploy
DATABASE_URL=postgresql://drift:drift-local-only@localhost:5432/drift

# Signs session tokens. This value is for local development only: generate your own with
#   openssl rand -base64 32
AUTH_SECRET=local-development-only-change-me-0000000000

# Redis: the run queue, live run events and rate limits.
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Traces (optional). With `docker compose --profile tracing up`, Jaeger listens here; its UI is http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=

# GitHub OAuth (optional; both or neither). Without them only email and password sign-in is offered.
GITHUB_ID=
GITHUB_SECRET=

# S3-compatible object storage for run artifacts (SeaweedFS from docker compose).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=drift-artifacts
S3_ACCESS_KEY_ID=drift
S3_SECRET_ACCESS_KEY=drift-local-only
