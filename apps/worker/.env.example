# Copy to apps/worker/.env for local development. Values match infra/docker-compose.yml.
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://drift:drift-local-only@localhost:5432/drift
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=drift-artifacts
S3_ACCESS_KEY_ID=drift
S3_SECRET_ACCESS_KEY=drift-local-only
LOG_LEVEL=info
# Traces to Jaeger (docker compose --profile tracing). Leave empty to turn tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Runs this worker processes at once, runs one organisation may have in progress (all workers), and the time
# limit of one run.
WORKER_CONCURRENCY=2
ORG_CONCURRENCY=2
RUN_TIMEOUT_MS=600000
