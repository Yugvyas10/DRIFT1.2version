{
  "name": "@drift/worker",
  "version": "0.0.0",
  "private": true,
  "description": "DRIFT background worker: runs server-side comparisons from the queue (BullMQ), with the engine in a worker thread.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "check": "node --env-file-if-exists=.env dist/main.js --check"
  },
  "dependencies": {
    "@drift/core": "workspace:*",
    "@drift/db": "workspace:*",
    "@drift/platform": "workspace:*",
    "@drift/report-schema": "workspace:*",
    "bullmq": "6.3.11",
    "piscina": "5.3.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "testcontainers": "12.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
