          "rules": [
            {
              "id": "DRIFT-REQ-OPERATION-REMOVED",
              "name": "DRIFT-REQ-OPERATION-REMOVED",
              "shortDescription": {
                "text": "operation.removed"
              },
              "fullDescription": {
                "text": "Clients still calling the operation will get an error; a recorded call to it proves the break."
              },
              "properties": {
                "kind": "operation.removed",
                "direction": "request"
              }
            },
            {
              "id": "DRIFT-REQ-SCHEMA-BOUND-TIGHTENED",
              "name": "DRIFT-REQ-SCHEMA-BOUND-TIGHTENED",
              "shortDescription": {
                "text": "schema.bound.tightened"
              },
              "fullDescription": {
                "text": "Values that used to be accepted may now be rejected."
              },
              "properties": {
                "kind": "schema.bound.tightened",
                "direction": "request"
              }
            },
            {
              "id": "DRIFT-REQ-SCHEMA-ENUM-VALUE-REMOVED",
              "name": "DRIFT-REQ-SCHEMA-ENUM-VALUE-REMOVED",
              "shortDescription": {
                "text": "schema.enum.value_removed"
              },
              "fullDescription": {
                "text": "Clients still sending the removed value will be rejected."
              },
              "properties": {
                "kind": "schema.enum.value_removed",
                "direction": "request"
              }
            },
            {
              "id": "DRIFT-REQ-SCHEMA-PROPERTY-ADDED-REQUIRED",
              "name": "DRIFT-REQ-SCHEMA-PROPERTY-ADDED-REQUIRED",
              "shortDescription": {
                "text": "schema.property.added.required"
              },
              "fullDescription": {
                "text": "Existing clients do not send the new property, so the server will reject their requests."
              },
              "properties": {
                "kind": "schema.property.added.required",
                "direction": "request"
              }
            },
            {
              "id": "DRIFT-RES-SCHEMA-ENUM-VALUE-ADDED",
              "name": "DRIFT-RES-SCHEMA-ENUM-VALUE-ADDED",
              "shortDescription": {
                "text": "schema.enum.value_added"
              },
              "fullDescription": {
                "text": "Clients that validate responses strictly may reject a value they have never seen."
              },
              "properties": {
                "kind": "schema.enum.value_added",
                "direction": "response"
              }
            }
          ]
        }
