# dependencies
node_modules/
.pnpm-store/

# build output
dist/
# ...except the Action's bundle: action.yml runs it, with no install step (CI checks it matches the source)
!packages/github-action/dist/
.next/
out/
*.tsbuildinfo

# Prisma client, generated by `prisma generate` in the db package's build
packages/db/src/generated/

# tooling caches and reports
.turbo/
coverage/
coverage-integration/
playwright-report/
test-results/

# DRIFT local stage cache and downloaded benchmark fixtures
.drift/
packages/bench/fixtures/.cache/

# env files: never commit secrets; .env.example files are committed
.env
.env.*
!.env.example
!**/.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel

# generated by Next.js
next-env.d.ts

# Claude Code per-user settings (launch.json is shared)
.claude/settings.local.json

# benchmark results are build artifacts, regenerated by the scripts
packages/bench/results/
