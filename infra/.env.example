POSTGRES_PASSWORD=drift-local-only
POSTGRES_DB=drift
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_BUCKET=drift-artifacts
S3_ACCESS_KEY_ID=drift
S3_SECRET_ACCESS_KEY=drift-local-only
S3_PORT=8333
