{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "APP_URL",
        "AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_ID",
        "GITHUB_SECRET",
        "NODE_ENV",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "env": [
        "APP_URL",
        "AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_ID",
        "GITHUB_SECRET",
        "NODE_ENV",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@drift/db#typecheck": {
      "dependsOn": ["build"]
    },
    "@drift/db#lint": {
      "dependsOn": ["build"]
    }
  }
}
